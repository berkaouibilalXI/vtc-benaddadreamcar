# ---------------------------------------------------------------
# Site statique pré-rendu (vite-react-ssg) :
#   /      -> index.html
#   /en/   -> en/index.html
# Plus de repli "SPA" vers /index.html : une URL inconnue renvoie un vrai 404
# (sinon Google indexerait des "soft 404" qui dupliquent la page d'accueil).
# ---------------------------------------------------------------
AddDefaultCharset UTF-8
DirectoryIndex index.html
Options -Indexes
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS (en tenant compte d'un éventuel proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html et /en/index.html -> /  et  /en/  (évite le contenu dupliqué)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]
</IfModule>

# Ne pas exposer les manifestes internes de Vite
RedirectMatch 404 ^/\.vite(/|$)

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml \
    application/javascript text/javascript application/json application/ld+json image/svg+xml
</IfModule>

# Cache : assets fingerprintés (js/css) = 1 an ; images = 30 jours ; HTML = toujours revalidé
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
