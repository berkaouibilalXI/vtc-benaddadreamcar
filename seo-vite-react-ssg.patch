+  // Pré-rendu statique (vite-react-ssg) : une page HTML par route de src/routes.jsx
+  ssgOptions: {
+    dirStyle: 'nested', // /en -> dist/en/index.html
+    script: 'async',
+    formatting: 'minify',
+    // react-helmet injecte les balises SEO en tout début de <head> : on remet
