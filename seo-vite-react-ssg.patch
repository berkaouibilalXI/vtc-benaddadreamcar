+<!doctype html>
+<html lang="fr">
+<head>
+  <meta charset="UTF-8" />
+  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
+  <meta name="robots" content="noindex, follow" />
+  <title>Page introuvable | Benadda DreamCar</title>
+  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
+  <style>
+    body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;font-family:Inter,system-ui,sans-serif;color:#111;background:#fff;text-align:center;padding:24px}
+    h1{font-size:clamp(28px,6vw,40px);margin:0 0 12px}
+    p{color:#6b6b6b;margin:0 0 24px;line-height:1.6}
+    a{display:inline-block;background:#b51f2a;color:#fff;text-decoration:none;font-weight:700;border-radius:999px;padding:14px 28px}
+    a.alt{background:transparent;color:#111;border:1px solid #111;margin-left:8px}
+  </style>
+</head>
+<body>
+  <main>
+    <img src="/logo-black.webp" alt="Benadda DreamCar" width="75" height="52" />
+    <h1>Page introuvable / Page not found</h1>
+    <p>La page demandée n’existe pas ou a été déplacée.<br />The page you requested does not exist or has moved.</p>
+    <a href="/">Accueil</a><a class="alt" href="/en/">Home (EN)</a>
+  </main>
+</body>
+</html>
